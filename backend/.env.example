# Copy to backend/.env and adjust. Every variable is optional; defaults are safe.
# Prefix: MEDIASAVER_

# --- Network hardening ---
# Per-hop connect / read timeouts (seconds)
MEDIASAVER_CONNECT_TIMEOUT_S=5.0
MEDIASAVER_READ_TIMEOUT_S=10.0
# Max HTML/manifest body we will inspect (bytes). Media segments are never fetched.
MEDIASAVER_MAX_RESPONSE_BYTES=2000000
# Max redirect hops, each re-validated for SSRF
MEDIASAVER_MAX_REDIRECTS=5
# Max submitted URL length (also enforced by Pydantic schema)
MEDIASAVER_MAX_URL_LENGTH=2048
# Max concurrent outbound fetches (anti-amplification)
MEDIASAVER_MAX_OUTBOUND_CONCURRENCY=8

# --- Rate limiting ---
# Analyses per minute per IP. 20 is generous for humans pasting links while
# making SSRF probing / scraping expensive. Set lower under abuse.
MEDIASAVER_RATE_LIMIT_PER_MINUTE=20

# --- CORS ---
# Exact origins (comma-separated) for browser dev UIs.
MEDIASAVER_CORS_ALLOW_ORIGINS=http://localhost:5173
# Regex for extension + loopback origins. Extension IDs differ per install, so
# chrome-extension:// origins can ONLY be matched here, never as exact entries
# (Starlette matches allow_origins exactly; "chrome-extension://*" matches nothing).
MEDIASAVER_CORS_ALLOW_ORIGIN_REGEX=chrome-extension://.*|http://localhost:\d+|http://127\.0\.0\.1:\d+

MEDIASAVER_LOG_LEVEL=INFO
